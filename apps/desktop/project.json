{
  "name": "desktop",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/desktop",
  "projectType": "application",
  "tags": ["scope:client"],
  "// targets": "to see all targets run: nx show project Spotify Sync --web",
  "targets": {
    "shadcn:add": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/desktop",
        "command": "pnpm dlx shadcn@latest add {args}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["^typecheck"],
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/tsconfig.base.json",
        {
          "dependentTasksOutputFiles": "**/*.{d.ts,tsbuildinfo}",
          "transitive": true
        },
        { "fileset": "{projectRoot}/**/*.d.ts", "dependencies": true },
        { "externalDependencies": ["next", "typescript"] }
      ],
      "outputs": [
        "{projectRoot}/.next/types/**/*.ts",
        "{projectRoot}/dist/tsconfig.tsbuildinfo"
      ],
      "syncGenerators": ["@nx/js:typescript-sync"],
      "options": {
        "cwd": "apps/athena",
        "command": "next typegen && tsc --project tsconfig.json --noEmit"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nx dev desktop"
      }
    },
    "dev": {
      "options": {
        "port": 3000
      }
    },
    "start": {
      "options": {
        "port": 3000
      }
    }
  }
}
