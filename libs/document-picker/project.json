{
  "name": "document-picker",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/document-picker/src",
  "projectType": "library",
  "tags": ["scope:client"],
  "// targets": "to see all targets run: nx show project document-picker --web",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/document-picker",
        "command": "pnpm nitrogen"
      }
    },
    "typecheck": {
      "dependsOn": ["build"]
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/document-picker",
        "command": "rm -rf nitrogen dist"
      }
    }
  }
}
